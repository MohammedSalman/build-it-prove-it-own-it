+def test_the_programme_shows_how_many_people_are_waiting(client):
+    event = event_by_title(client, WORKSHOP)
+    client.post(f"/api/events/{event['id']}/waitlist", json=LEE)
+    client.post(f"/api/events/{event['id']}/waitlist", json=PRIYA)
