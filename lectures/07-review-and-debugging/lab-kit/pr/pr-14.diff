+from .conftest import event_by_title
+
+WORKSHOP = "Maker Workshop: Solder Your Own Badge"   # seeded full (12 of 12)
+BOARD_GAMES = "Board Game Night"                     # plenty of places
+
+LEE = {"attendee": "Lee", "email": "lee@example.org"}
+PRIYA = {"attendee": "Priya", "email": "priya@example.org"}
+
+
+def test_people_can_join_the_waitlist_of_a_full_event(client):
+    event = event_by_title(client, WORKSHOP)
+    res = client.post(f"/api/events/{event['id']}/waitlist", json=LEE)
+    assert res.status_code == 201
+    assert res.json()["position"] == 1
+
+
+def test_the_waitlist_keeps_the_order_people_joined_in(client):
+    event = event_by_title(client, WORKSHOP)
+    client.post(f"/api/events/{event['id']}/waitlist", json=LEE)
+    res = client.post(f"/api/events/{event['id']}/waitlist", json=PRIYA)
+    assert res.json()["position"] == 2
+
+
+def test_you_cannot_wait_for_an_event_with_free_places(client):
+    event = event_by_title(client, BOARD_GAMES)
+    res = client.post(f"/api/events/{event['id']}/waitlist", json=LEE)
+    assert res.status_code == 409
+
