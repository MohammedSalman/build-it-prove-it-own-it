new file mode 100644
index 0000000..4580c5e
--- /dev/null
+++ b/app/waitlist.py
@@ -0,0 +1,56 @@
+"""The waitlist: when an event is full, people can queue for a place."""
+
+import logging
+
+from . import db
+from .reservations import EventNotFound
+
+log = logging.getLogger("afterhours")
+
+
+class NotFull(Exception):
+    """The event still has places, so there is nothing to wait for."""
+
+
+def join(event_id: int, attendee: str, email: str) -> dict:
+    """Put `attendee` at the end of the event's waitlist.
+
+    Returns the waitlist entry with its position (1 = next in line).
+    Raises EventNotFound, or NotFull if the event still has places.
+    """
+    conn = db.connect()
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            event = db.query_one(conn, "SELECT id, capacity FROM events WHERE id = ?", (event_id,))
+            if event is None:
+                raise EventNotFound(event_id)
+            taken = db.query_one(
+                conn, "SELECT COUNT(*) AS n FROM reservations WHERE event_id = ?", (event_id,)
+            )["n"]
+            if taken < event["capacity"]:
+                raise NotFull(event_id)
+            cur = conn.execute(
+                "INSERT INTO waitlist (event_id, attendee, email) VALUES (?, ?, ?)",
+                (event_id, attendee, email),
+            )
+            position = db.query_one(
+                conn, "SELECT COUNT(*) AS n FROM waitlist WHERE event_id = ? AND id <= ?",
+                (event_id, cur.lastrowid),
+            )["n"]
+            conn.execute("COMMIT")
+        except BaseException:
+            if conn.in_transaction:
+                conn.execute("ROLLBACK")
+            raise
+        log.info("[%s] joined the waitlist for event %d at position %d", attendee, event_id, position)
+        return {"id": cur.lastrowid, "event_id": event_id, "attendee": attendee, "position": position}
+    finally:
+        conn.close()
+
+
+def waiting(conn, event_id: int) -> int:
+    """How many people are waiting for this event."""
+    return db.query_one(
+        conn, "SELECT COUNT(*) AS n FROM waitlist WHERE event_id = ?", (event_id,)
+    )["n"]
