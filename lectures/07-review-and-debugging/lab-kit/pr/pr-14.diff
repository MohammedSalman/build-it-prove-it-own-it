+def test_cancelling_with_nobody_waiting_just_frees_the_place(client):
+    event = event_by_title(client, WORKSHOP)
+    first_guest = _first_reservation_id(event["id"])
+    client.delete(f"/api/reservations/{first_guest}")
+    assert event_by_title(client, WORKSHOP)["places_left"] == 1
+
+
+def _first_reservation_id(event_id):
+    from app import db
+    conn = db.connect()
+    try:
+        return db.query_one(conn, "SELECT MIN(id) AS id FROM reservations WHERE event_id = ?",
+                            (event_id,))["id"]
+    finally:
+        conn.close()
