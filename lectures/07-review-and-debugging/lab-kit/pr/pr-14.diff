+def test_a_cancellation_gives_the_place_to_the_first_person_waiting(client):
+    event = event_by_title(client, WORKSHOP)
+    client.post(f"/api/events/{event['id']}/waitlist", json=LEE)
+    client.post(f"/api/events/{event['id']}/waitlist", json=PRIYA)
+
+    first_guest = _first_reservation_id(event["id"])
+    assert client.delete(f"/api/reservations/{first_guest}").status_code == 204
+
+    after = event_by_title(client, WORKSHOP)
+    assert after["reserved"] == 12        # still full: Lee took the freed place
+    assert after["waitlist"] == 1         # only Priya is still waiting
+
